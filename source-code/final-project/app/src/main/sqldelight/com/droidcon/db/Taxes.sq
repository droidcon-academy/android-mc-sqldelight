CREATE TABLE IF NOT EXISTS taxEntity(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    desc TEXT NOT NULL,
    value INTEGER NOT NULL
);

getTaxes:
SELECT *
FROM taxEntity
ORDER BY desc ASC ;

addTax:
INSERT OR REPLACE
INTO taxEntity(desc, value)
VALUES (:desc, :value);

lastInsertRowId:
SELECT last_insert_rowid();

deleteTax:
DELETE FROM taxEntity
WHERE id = :id ;